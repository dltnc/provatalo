DATABASE_URL=mongodb://127.0.0.1/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# Public origin, used for preview URLs and canonical/OG tags.
NEXT_PUBLIC_SERVER_URL=http://localhost:3000

# Authorizes the Vercel Cron that runs the jobs queue (scheduled publishing).
# Vercel sends this automatically as `Authorization: Bearer $CRON_SECRET` once the variable is
# set in the project. Locally, generate any random string.
CRON_SECRET=YOUR_CRON_SECRET_HERE

# Cloudflare R2 for media (docs/deployment.md §3). Leave the whole block unset locally: the S3
# adapter keys off R2_BUCKET and disables itself without it, keeping uploads on local disk.
R2_BUCKET=your-bucket-name
R2_ACCESS_KEY_ID=YOUR_R2_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=YOUR_R2_SECRET_ACCESS_KEY
# S3 API endpoint — uploads only; it cannot serve files to browsers.
R2_ENDPOINT=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
# Public bucket domain files are served from. Also read at *build* time by next.config.ts, which
# allow-lists this host for next/image.
R2_PUBLIC_URL=https://media.your-domain.com
